{
  "name": "clanker-forge",
  "version": "0.0.1",
  "private": true,
  "description": "Toolkit for AI coding agents: portable skills plus a single-source generator that syncs rules, commands, subagents, and MCP config across Claude Code, Cursor, and Codex.",
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "format-and-lint": "biome check .",
    "format-and-lint:fix": "biome check . --write",
    "format-and-lint:unsafe": "biome check . --write --unsafe"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "catalog:",
    "turbo": "^2.10.7",
    "typescript": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.16.0",
      "onFail": "download"
    }
  }
}
