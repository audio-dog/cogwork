{
  "name": "cogwork",
  "version": "0.0.1",
  "private": true,
  "description": "Orchestration control plane for AI coding agents: discover work, schedule runs, and drive harnesses.",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "format-and-lint:fix": "oxfmt --disable-nested-config && biome lint . --write",
    "format-and-lint:unsafe": "oxfmt --disable-nested-config && biome lint . --write --unsafe",
    "format-and-lint": "oxfmt --check --disable-nested-config && biome lint .",
    "prepare": "effect-tsgo patch && node scripts/install-commit-hook.mjs",
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "vendor": "node scripts/vendor.mjs",
    "setup-worktree": "node scripts/setup-worktree.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@cogwork/contracts": "workspace:*",
    "@effect/platform-node": "catalog:effect",
    "@effect/tsgo": "catalog:",
    "@j178/prek": "0.5.3",
    "@types/node": "catalog:",
    "effect": "catalog:effect",
    "oxfmt": "0.79.0",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.13.0",
      "onFail": "download"
    }
  }
}
