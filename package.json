{
  "name": "cogwork",
  "version": "0.0.1",
  "private": true,
  "description": "Orchestration control plane for AI coding agents: discover work, schedule runs, and drive harnesses.",
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "format-and-lint:fix": "biome check . --write",
    "format-and-lint:unsafe": "biome check . --write --unsafe",
    "format-and-lint": "biome check .",
    "prepare": "effect-tsgo patch",
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test && tsx scripts/count-worktree-git-invocations.ts",
    "test:measure": "node scripts/test-measure.mjs",
    "worktree:git-invocations": "tsx scripts/count-worktree-git-invocations.ts",
    "test:lint-rules": "node --test configs/lint/tests/rules.test.mjs",
    "vendor": "node scripts/vendor.mjs",
    "setup-worktree": "node scripts/setup-worktree.mjs",
    "register-workspaces": "node scripts/register-workspaces.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@cogwork/contracts": "workspace:*",
    "@effect/platform-node": "catalog:effect",
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:effect",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.20.0",
      "onFail": "download"
    }
  }
}
