{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && pnpm format-and-lint:fix",
            "timeout": 120,
            "statusMessage": "Formatting workspace"
          }
        ]
      }
    ]
  }
}
