{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!**/routeTree.gen.ts"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 110
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"]
          }
        }
      },
      "nursery": {
        "useReactCompiler": "error"
      }
    }
  },
  "plugins": [
    "./configs/lint/no-flatmap-ladder.grit",
    "./configs/lint/no-effect-ladder.grit",
    "./configs/lint/no-nested-effect-call.grit",
    "./configs/lint/no-nested-effect-gen.grit",
    "./configs/lint/no-arrow-ladder.grit",
    "./configs/lint/no-effect-orElse-ladder.grit",
    "./configs/lint/no-iife-wrapper.grit",
    "./configs/lint/no-effect-step-const-staging.grit",
    "./configs/lint/no-pipeline-fragment-staging.grit",
    "./configs/lint/no-effect-all-step-sequencing.grit",
    "./configs/lint/no-effect-as.grit",
    "./configs/lint/no-option-as.grit",
    "./configs/lint/no-effect-side-effect-wrapper.grit",
    "./configs/lint/no-effect-bind.grit",
    "./configs/lint/no-effect-do.grit",
    "./configs/lint/no-effect-fn-generator.grit",
    "./configs/lint/no-match-effect-branch.grit",
    "./configs/lint/no-match-void-branch.grit",
    "./configs/lint/warn-effect-sync-wrapper.grit",
    "./configs/lint/no-runtime-runfork.grit",
    "./configs/lint/no-effect-never.grit",
    "./configs/lint/no-side-effect-in-state-updater.grit"
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/routes/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    }
  ]
}
