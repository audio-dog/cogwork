{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!**/*.gen.ts", "!**/.tanstack-output-schema-codex-*.json"]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none"
    }
  },
  "plugins": [
    "./configs/lint/effect-calls.grit",
    "./configs/lint/iife.grit",
    "./configs/lint/staging.grit",
    "./configs/lint/member-calls.grit",
    "./configs/lint/gated.grit",
    "./configs/lint/no-effect-ladder.grit",
    "./configs/lint/no-env-file-load.grit",
    "./configs/lint/no-flatmap-ladder.grit",
    "./configs/lint/no-side-effect-in-state-updater.grit"
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": false
  },
  "overrides": [
    {
      "includes": ["configs/lint/tests/fixtures/**"],
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": ["**/*.jsx", "**/*.tsx"],
      "plugins": ["./configs/lint/jsx.grit"]
    },
    {
      "includes": ["apps/desktop/src/**", "packages/ui/src/**"],
      "plugins": ["./configs/lint/no-use-effect.grit"]
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "plugins": ["./configs/lint/no-bare-exit-failure.grit"]
    }
  ]
}
