{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!**/*.gen.ts", "!**/.tanstack-output-schema-codex-*.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 110
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"]
          }
        }
      },
      "nursery": {
        "useReactCompiler": "error"
      }
    }
  },
  "plugins": [
    "./configs/lint/no-use-effect.grit",
    "./configs/lint/ladders.grit",
    "./configs/lint/effect-calls.grit",
    "./configs/lint/iife.grit",
    "./configs/lint/staging.grit",
    "./configs/lint/member-calls.grit",
    "./configs/lint/gated.grit",
    "./configs/lint/no-side-effect-in-state-updater.grit",
    "./configs/lint/no-native-button-mismatch.grit"
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["configs/lint/tests/fixtures/**"],
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": ["**/routes/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    }
  ]
}
