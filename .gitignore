node_modules/
dist/

.env

# Consumer artifact written by `npx skills add`, not authored here
skills-lock.json

# Local generator output when targeting this repo as a project dir
/.claude/
# `sync` owns .cursor/, but worktrees.json is hand-authored and tracked. Ignore the
# directory's contents (not the dir itself) so the negation below can re-include it.
/.cursor/*
!/.cursor/worktrees.json
/CLAUDE.md
/.mcp.json

.DS_Store
*.log
.turbo

# Sandbox projection written by the TanStack AI local-process harness at runtime
.tanstack-projected*

# Vendored reference source (Effect v4, etc.), pinned by `pnpm vendor`.
# No trailing slash: a real dir in the main checkout, a symlink in a hydrated worktree.
/.repos

# Per-repo skill config may reference employer-internal details; this repo is public,
# so everything but the convention doc stays local-only.
/repo-config/*
!/repo-config/README.md
/docs