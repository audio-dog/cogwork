node_modules/
dist/
out/

.pnpm-store/

.env

# Consumer artifact written by `npx skills add`, not authored here
skills-lock.json

# Local generator output when targeting this repo as a project dir.
# `settings.json` is authored here (it carries the worktree-setup hook), so it is
# re-included — which needs `/*` rather than `/`, since git cannot un-ignore a file
# inside an ignored directory. `.mcp.json` is authored here too — it carries the
# desktop-app attachment every harness needs — so it is not ignored at all.
/.claude/*
!/.claude/settings.json

# `drizzle-kit skills` writes its bundled skills into the package that owns drizzle-kit, plus a
# Claude Code symlink mirror. They ship inside the dependency and `@tanstack/intent` already
# discovers them from there, so the copies are local convenience, not repository content.
packages/*/.agents/skills/drizzle*
packages/*/.claude/

.DS_Store
*.log
.turbo

# Sandbox projection written by the TanStack AI local-process harness at runtime
.tanstack-projected*
.tanstack-output-schema*

# Vendored reference source (Effect v4, etc.), pinned by `pnpm vendor`.
# No trailing slash: a real dir in the main checkout, a symlink in a hydrated worktree.
/.repos

# TypeScript incremental build state
*.tsbuildinfo
