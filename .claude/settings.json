{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/claude-worktree-setup.mjs\"",
            "statusMessage": "Hydrating worktree"
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/claude-worktree-setup.mjs\"",
            "statusMessage": "Hydrating worktree"
          }
        ]
      }
    ]
  }
}
