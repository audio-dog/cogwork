{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": ["ROOT_WORKTREE_PATH"],
  "tasks": {
    "//#format-and-lint": {},
    "//#format-and-lint:fix": {
      "cache": false
    },
    "test": {
      "dependsOn": ["transit", "^test"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
