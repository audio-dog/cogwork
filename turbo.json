{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": ["COGWORK_HOME", "COGWORK_SOCKET", "ROOT_WORKTREE_PATH"],
  "tasks": {
    "//#format-and-lint": {},
    "//#format-and-lint:fix": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["out/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["NODE_PATH", "ELECTRON_*", "REMOTE_DEBUGGING_PORT"]
    },
    "test": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/configs/vitest/base.ts"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
