{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "resolvePackageJsonImports": true,
    "types": ["electron-vite/node"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": false
      }
    ]
  },
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "vitest.config.ts"
  ]
}
