{
  "name": "@cogwork/desktop",
  "version": "0.0.0",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "Taylor Steele",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts",
    "#renderer/*": "./src/renderer/*.tsx"
  },
  "scripts": {
    "build:linux": "electron-vite build && electron-builder --linux",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "routes:generate": "tsr generate",
    "postinstall": "node scripts/ensure-electron.mjs && electron-builder install-app-deps",
    "start": "electron-vite preview",
    "test": "vitest run",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && npm run typecheck:web"
  },
  "dependencies": {
    "@cogwork/contracts": "workspace:*",
    "@cogwork/process-diagnostics": "workspace:*",
    "@cogwork/ui": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@effect/atom-react": "catalog:effect",
    "@effect/platform-node": "catalog:effect",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@react-hookz/web": "^26.1.0",
    "@remixicon/react": "^4.9.0",
    "@tanstack/highlight": "^0.0.10",
    "@tanstack/markdown": "^0.0.13",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "^1.170.32",
    "effect": "catalog:effect",
    "electron-log": "^5.2.0",
    "electron-window-state": "^5.0.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@cogwork/test-config": "workspace:*",
    "@effect/vitest": "catalog:effect",
    "@electron/fuses": "^1.8.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-form-devtools": "^0.2.34",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/router-cli": "^1.167.33",
    "@tanstack/router-plugin": "^1.168.35",
    "@types/babel__core": "^7.20.5",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.2.2",
    "vitest": "catalog:"
  }
}
