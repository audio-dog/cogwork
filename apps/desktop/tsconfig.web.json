{
  "extends": "../../tsconfig.base.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "resolvePackageJsonImports": true,
    "jsx": "react-jsx",
    "plugins": [{ "name": "@effect/language-service", "diagnostics": false }]
  }
}
