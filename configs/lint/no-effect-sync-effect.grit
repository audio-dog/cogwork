language js(typescript, jsx)

// Effect.sync returns Effect<A> for whatever the thunk returns. When the thunk returns an
// Effect, A is itself an Effect, so the inner Effect is built and then discarded unrun.
// Only a literal `Effect.*` callee is detectable here; a helper that returns an Effect needs
// type information Grit does not have, so this catches the obvious form, not every one.
or {
  `Effect.sync($fn)` as $call,
  `Effect.sync<$types>($fn)` as $call
} where {
  $fn <: `() => $expr`,
  or {
    $expr <: `Effect.$method($_)`,
    $expr <: `Effect.$method<$_>($_)`,
    $expr <: `Effect.$method($_).pipe($_)`
  },
  register_diagnostic(span=$call, message="Rule: do not return an Effect from Effect.sync. Why: the result is Effect<Effect<...>>, so the inner Effect is constructed and never run — a silent no-op. Fix: use Effect.suspend to defer building it, or call it directly when laziness is not needed.", severity="error")
}
