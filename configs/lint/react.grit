language js(typescript, jsx)

// These share a file because both key on a call root, so they cost one pass, not two.
// See issue #433.
//
// A React state updater must be a pure function of the previous state. React can
// run an updater more than once (StrictMode double-invoke, concurrent replay), so
// a browser-storage write inside it may run twice or observe stale external state.

any {
  `useEffect($ueArgs)` as $ueCall where {
    register_diagnostic(span=$ueCall, message="Direct useEffect() calls are not allowed. Refactor to derived state, event handlers, the key prop, or a data-fetching library. See .agents/skills/react-no-use-effect. If you must keep it, suppress inline with a reason.", severity="error")
  },
  `React.useEffect($reArgs)` as $reCall where {
    register_diagnostic(span=$reCall, message="Direct useEffect() calls are not allowed. Refactor to derived state, event handlers, the key prop, or a data-fetching library. See .agents/skills/react-no-use-effect. If you must keep it, suppress inline with a reason.", severity="error")
  },
  `$setter($updater)` where {
    $setter <: r"set[A-Z][A-Za-z0-9_]*",
    $updater <: or {
      `$single_param => $arrow_body`,
      `($params) => $arrow_body`,
      `function ($params) { $fn_body }`,
      `function $fn_name($params) { $fn_body }`
    },
    $updater <: contains `$storage.$method($args)` where {
      $storage <: or {
        `localStorage`,
        `sessionStorage`,
        `window.localStorage`,
        `window.sessionStorage`,
        `globalThis.localStorage`,
        `globalThis.sessionStorage`
      },
      $method <: or {
        `setItem`,
        `removeItem`,
        `clear`
      }
    },
    register_diagnostic(span=$updater, message="Rule: no side effect inside a React state updater. Why: React may run the updater more than once (StrictMode double-invoke, concurrent replay), so a browser-storage write here can run twice or observe stale external state. Fix: compute the next state and return it; write to storage in the event handler or effect (reuse the setter that persists + sets state).", severity="error")
  }
}
