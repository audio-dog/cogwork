    "@tanstack/ai-sandbox": "catalog:",
    "@tanstack/ai-sandbox-local-process": "catalog:",
    "effect": "catalog:effect"
  },
  "devDependencies": {
    "@cogwork/test-config": "workspace:*",
    "@effect/platform-node": "catalog:effect",
    "@effect/vitest": "catalog:effect",
    "@tanstack/ai-persistence": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
