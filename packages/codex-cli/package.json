{
  "name": "@cogwork/codex-cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Codex CLI harness runner for Cogwork, built on the TanStack AI Codex adapter",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:codex-live": "COGWORK_LIVE_CODEX_PROBE=1 vitest run src/harness.test.ts"
  },
  "dependencies": {
    "@cogwork/contracts": "workspace:*",
    "@cogwork/engine": "workspace:*",
    "@feojs/regex": "0.0.1-alpha.0",
    "@tanstack/ai": "catalog:",
    "@tanstack/ai-codex": "catalog:",
    "@tanstack/ai-sandbox": "catalog:",
    "@tanstack/ai-sandbox-local-process": "catalog:",
    "effect": "catalog:effect",
    "proper-lockfile": "4.1.2",
    "smol-toml": "1.3.4"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:effect",
    "@effect/vitest": "catalog:effect",
    "@tanstack/ai-persistence": "catalog:",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
