{
  "name": "@cogwork/cursor-acp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cursor `agent acp` harness runner for cogwork, built on TanStack AI acpCompatible + localProcessSandbox",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "models:sync": "node --experimental-strip-types scripts/sync-models.ts",
    "models:check": "node --experimental-strip-types scripts/sync-models.ts --check",
    "spike:run": "node --env-file=.env --experimental-strip-types run.ts",
    "spike:probe": "node --env-file=.env --experimental-strip-types probe-acp.ts",
    "spike:mcp": "node --env-file-if-exists=.env --experimental-strip-types probe-mcp.ts",
    "spike:resume": "node --env-file-if-exists=.env --experimental-strip-types probe-resume.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.25.1",
    "@cogwork/contracts": "workspace:*",
    "@cogwork/engine": "workspace:*",
    "@tanstack/ai": "catalog:",
    "@tanstack/ai-acp": "0.3.8",
    "@tanstack/ai-sandbox": "catalog:",
    "@tanstack/ai-sandbox-local-process": "catalog:",
    "effect": "catalog:effect"
  },
  "devDependencies": {
    "@cogwork/test-config": "workspace:*",
    "@effect/vitest": "catalog:effect",
    "@tanstack/ai-persistence": "catalog:",
    "gpt-tokenizer": "^4.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
